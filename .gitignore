# ===============================
# OS / Editor junk
# ===============================
.DS_Store
Thumbs.db
*.log
*.tmp

# VS Code
.vscode/
!.vscode/extensions.json

# ===============================
# Node / React / Vite
# ===============================
node_modules/
dist/
build/
.cache/
.vite/

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===============================
# Environment variables (IMPORTANT)
# ===============================
.env
.env.local
.env.*.local

# ===============================
# Mobirise (VERY IMPORTANT)
# ===============================
# Mobirise generates heavy assets — ignore them
assets/
bootstrap/
mobirise/
fonts/
images/
css/
js/

# Mobirise cache & backups
*.mbcache
*.backup

# ===============================
# Do NOT ignore these (explicit keep)
# ===============================
!index.html
!project.mobirise
!README.md
